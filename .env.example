# ====================================================================
# Hairdrama Tech Task Management - Root Environment Variables
# Copy this file or use the respective .env files in /backend and /frontend.
# ====================================================================

# --------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# --------------------------------------------------
PORT=5000
FLASK_DEBUG=True
DEV_MODE=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Supabase PostgreSQL Database & Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Gmail SMTP Email Notification Service
# NOTE: Use a Google 16-character App Password (not your Gmail password).
# Steps: Google Account -> Security -> 2-Step Verification -> App Passwords -> Generate
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Gmail REST API over HTTPS (REQUIRED on Render free tier, which blocks SMTP ports)
# Generate with: python backend/scripts/get_gmail_refresh_token.py <CLIENT_ID> <CLIENT_SECRET>
# When set, emails go via the Gmail API first; SMTP is used as a fallback.
GMAIL_CLIENT_ID=your-desktop-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-desktop-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-send-refresh-token

# CORS & Public Link Settings
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# --------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
