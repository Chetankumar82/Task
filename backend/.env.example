# ====================================================================
# Hairdrama Tech Task Management - Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# ====================================================================

# Flask Application Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_DEBUG=True
PORT=5000
DEV_MODE=False

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Gmail SMTP Configuration for Email Notifications
# NOTE: Use a Google App Password (not your normal Gmail password).
# Steps to generate: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Frontend Application URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
